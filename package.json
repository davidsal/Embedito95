{
  "name": "embedito95",
  "version": "0.1.3",
  "private": true,
  "license": "AGPL-3.0-only WITH LicenseRef-Embedito95-Runtime-Exception-1.0",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node packages/cli/scripts/sync-extension-version.js",
    "release": "pnpm --filter embedito95-cli publish",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "pnpm run --filter @embedito95/test test",
    "test:snapshot": "pnpm run --filter @embedito95/test test:snapshot",
    "test:compile": "pnpm run --filter @embedito95/test test:compile",
    "test:compile:checks": "pnpm run --filter @embedito95/test test:compile:checks",
    "test:runtime": "pnpm run --filter @embedito95/test test:runtime",
    "test:run": "pnpm run --filter @embedito95/test test:run",
    "test:leak": "pnpm run --filter @embedito95/test test:leak",
    "test:bench": "pnpm run --filter @embedito95/test test:bench",
    "test:full": "pnpm run lint && pnpm run test && pnpm run test:run && pnpm run test:leak && pnpm run test:compile:checks && pnpm run test:runtime && pnpm run test:compile",
    "docs:sync": "node packages/cli/scripts/sync-docs.js",
    "prepare": "node packages/cli/scripts/sync-docs.js && git config core.hooksPath .githooks || true",
    "embedito95-cli": "node packages/cli/src/cli.js --force",
    "lsp:install": "node packages/cli/scripts/build-extension.js && code --install-extension packages/cli/assets/embedito95-lsp.vsix"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^3.0.3"
  }
}
