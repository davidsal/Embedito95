{
	"name": "embedito95-cli",
	"version": "1.0.2",
	"description": "Embedito95 command-line toolchain: init, build, compile, upload and monitor e95 projects",
	"type": "module",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davidsal/Embedito95.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/davidsal/Embedito95#readme",
	"bugs": {
		"url": "https://github.com/davidsal/Embedito95/issues"
	},
	"keywords": [
		"embedito95",
		"e95",
		"microcontroller",
		"arduino",
		"stm32",
		"embedded",
		"compiler"
	],
	"bin": {
		"embedito95": "./src/cli.js",
		"embedito95-cli": "./src/cli.js"
	},
	"files": [
		"src",
		"docs",
		"assets"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepack": "node scripts/sync-docs.js && node scripts/resolve-bundled-dependencies.js && node scripts/build-extension.js",
		"postpack": "node scripts/resolve-bundled-dependencies.js --restore"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"embedito95-core": "workspace:*",
		"embedito95-registry": "workspace:*"
	},
	"bundledDependencies": [
		"embedito95-core",
		"embedito95-registry"
	]
}
