import { Pin } from '@embedito95/gpio'

// e95.postinstall.interruptRules

/**
 * Signal transition that triggers a pin interrupt.
 */
export enum InterruptMode {
    LOW,
    CHANGE,
    RISING,
    FALLING
}

/**
 * Registers `handler` to run when `pin` reports the transition selected by
 * `mode`. The pin must expose an interrupt channel and the mode must be one the
 * pin supports. `handler` runs in interrupt context, so it must be a top-level
 * function without parameters and without captured state.
 * @param pin - Pin whose interrupt channel is used
 * @param handler - Function invoked on each matching transition
 * @param mode - Signal transition that triggers the handler
 */
export const attachPinInterrupt = (pin: Pin, handler, mode: InterruptMode) => {}

/**
 * Stops delivering interrupts from `pin`. The pin keeps its current
 * configuration; only callback delivery stops.
 * @param pin - Pin whose interrupt channel is released
 */
export const detachPinInterrupt = (pin: Pin) => {}

/**
 * Reports the interrupt channel number wired to `pin`.
 * @param pin - Pin to query
 * @returns The interrupt channel number, or `255` when the pin has no channel
 */
export const getInterruptNumber = (pin: Pin): u8 => {}

/**
 * Enables interrupt delivery.
 */
export const enableInterrupts = () => {}

/**
 * Disables interrupt delivery.
 */
export const disableInterrupts = () => {}
