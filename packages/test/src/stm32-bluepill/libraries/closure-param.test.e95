import { getSerial, Serial } from '@embedito95/serial'

const serial = getSerial(Serial.1)

type Counter = {
    increment: () => void
    getValue: () => i16
}

// Class-form closure: the factory hoists a PRIVATE closure (`add`) that the
// public methods call, so this closure keeps the self-contained `class`
// (`Ref<Body>` + member methods) instead of the shared `Object<T>` handle form
// -- the same shape a stateful driver like dht22 now emits after reverting its
// captured-state closure to a class.
const makeCounter = (): Counter => {
    let count: i16 = 0
    const add = (amount: i16) => {
        count = count + amount
    }
    return {
        increment: () => {
            add(1)
        },
        getValue: () => {
            return count
        }
    }
}

// Passing a class-form closure BY VALUE still SHARES the captured state: the
// increment below mutates the caller's object (write-through), because the
// parameter aliases the same Ref body; then rebinding the parameter to a fresh
// counter only repoints the LOCAL handle (binding vs content), so the caller's
// object is untouched by the increments that follow the rebind.
const bumpCounter = (c: Counter): i16 => {
    c.increment()
    c = makeCounter()
    c.increment()
    c.increment()
    return c.getValue()
}

const setup = () => {
    serial.initialize(9600)
}

const main = () => {
    setup()
    const counter = makeCounter()
    counter.increment()
    counter.increment()
    const viaClosure = bumpCounter(counter)
    // counter.getValue() == 3 (2 here + 1 write-through inside bumpCounter)
    // viaClosure == 2 (a fresh local counter rebinding only repointed the param)
    serial.sendLine(counter.getValue())
    serial.sendLine(viaClosure)
}

main()
