import { getSerial, Serial } from '@embedito95/serial'

const serial = getSerial(Serial.1)

// Array<T> is a shared-mutable handle (like a data object, NOT copy-on-write):
// copying a handle aliases the same storage, and mutating through any handle or
// a function parameter is visible to the others.

// Write-through: pushing through a parameter reaches the caller's array.
const addValue = (arr: i16[], v: i16) => {
    arr.push(v)
}

// Reassigning the parameter rebinds only the LOCAL handle; caller is untouched.
const resetArr = (arr: i16[]) => {
    const fresh: i16[] = [100, 200]
    arr = fresh
}

const setup = () => {
    serial.initialize(9600)
}

const main = () => {
    setup()

    const a: i16[] = [1, 2, 3]

    // Alias shares the storage.
    let b = a
    b.push(9)
    serial.sendLine(a.length())
    serial.sendLine(b.length())

    // Write-through through a param reaches the caller.
    addValue(a, 7)
    serial.sendLine(a.length())
    serial.sendLine(b.length())

    // Rebinding is local only.
    resetArr(a)
    serial.sendLine(a.length())

    // A fresh literal is independent.
    const c: i16[] = [5, 6]
    c.push(1)
    serial.sendLine(c.length())
    serial.sendLine(a.length())
}

main()
