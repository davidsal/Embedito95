import { getSerial, Serial } from '@embedito95/serial'

const serial = getSerial(Serial.1)

type SensorConfig = {
    pin: i16
    label: string
    isValid?: boolean
}

const makePoint = (x: i16, y: i16) => {
    return { x: x, y: y }
}

type Counter = {
    increment: () => void
    getValue: () => i16
}

const makeCounter = (): Counter => {
    let count: i16 = 0

    return {
        increment: () => {
            count = count + 1
        },
        getValue: () => {
            return count
        }
    }
}

const bumpCounter = (c: Counter): i16 => {
    c.increment()
    c = makeCounter()
    c.increment()
    return c.getValue()
}

const setup = () => {
    serial.initialize(9600)
}

const main = () => {
    setup()
    const sensorConfig: SensorConfig = { pin: 3, label: "dht22", isValid: true }
    const minimalConfig: SensorConfig = { pin: 4, label: "tmp36" }
    const point = makePoint(5, 10)
    const counter = makeCounter()
    counter.increment()
    counter.increment()
    const viaClosure = bumpCounter(counter)
    serial.sendLine(sensorConfig.pin)
    serial.sendLine(minimalConfig.pin)
    serial.sendLine(point.x)
    serial.sendLine(counter.getValue())
    serial.sendLine(viaClosure)
}

main()
