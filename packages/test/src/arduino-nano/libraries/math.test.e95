import {
    interpolateRange, interpolateRangeFloat, clamp, clampFloat,
    power, squareRoot, absolute, absoluteFloat, minimum, minimumFloat,
    maximum, maximumFloat, roundDown, roundUp, roundNearest,
    randomInteger, seedRandom, readBitValue, writeBitValue, setBitValue,
    clearBitValue, lowByteValue, highByteValue, bitMask,
    sine, cosine, tangent, arcSine, arcCosine, arcTangent, arcTangent2,
    toRadians, toDegrees, square, naturalLog, logarithm10, exponential,
    remainderFloat, truncate
} from '@embedito95/math'

// Pure computation: no wiring required on the Arduino Nano.

const testInterpolateRangeIntegers = () => {
    const atMinimum: i32 = interpolateRange(0, 0, 1023, 0, 255)
    const atMaximum: i32 = interpolateRange(1023, 0, 1023, 0, 255)
    const middle: i32 = interpolateRange(512, 0, 1023, 0, 255)
    // Inverted target range (decreasing output).
    const inverted: i32 = interpolateRange(1023, 0, 1023, 255, 0)
    // Target span smaller than the source span (truncated like integer division).
    const narrow: i32 = interpolateRange(5, 0, 10, 0, 1)
    return atMinimum + atMaximum + middle + inverted + narrow
}

const testInterpolateRangeFloat = () => {
    const atMinimum: f32 = interpolateRangeFloat(0.0, 0.0, 1023.0, 0.0, 5.0)
    const atMaximum: f32 = interpolateRangeFloat(1023.0, 0.0, 1023.0, 0.0, 5.0)
    const inverted: f32 = interpolateRangeFloat(1023.0, 0.0, 1023.0, 5.0, 0.0)
    return atMinimum + atMaximum + inverted
}

const testClampIntegers = () => {
    const below: i32 = clamp(-10, 0, 100)
    const inside: i32 = clamp(50, 0, 100)
    const above: i32 = clamp(250, 0, 100)
    return below + inside + above
}

const testClampFloat = () => {
    const below: f32 = clampFloat(-1.5, 0.0, 1.0)
    const inside: f32 = clampFloat(0.5, 0.0, 1.0)
    const above: f32 = clampFloat(2.5, 0.0, 1.0)
    return below + inside + above
}

const testIntegerMath = () => {
    const magnitude: i32 = absolute(-42)
    const smallest: i32 = minimum(3, 8)
    const largest: i32 = maximum(3, 8)
    return magnitude + smallest + largest
}

const testFloatMath = () => {
    const raised: f32 = power(2.0, 10.0)
    const root: f32 = squareRoot(16.0)
    const squared: f32 = square(4.0)
    const magnitude: f32 = absoluteFloat(-3.5)
    const smallest: f32 = minimumFloat(1.5, 0.5)
    const largest: f32 = maximumFloat(1.5, 0.5)
    return raised + root + squared + magnitude + smallest + largest
}

const testLogarithms = () => {
    const natural: f32 = naturalLog(2.718282)
    const decimal: f32 = logarithm10(100.0)
    const raised: f32 = exponential(1.0)
    return natural + decimal + raised
}

const testRemainderAndTruncate = () => {
    const remainder: f32 = remainderFloat(5.5, 2.0)
    const negativeRemainder: f32 = remainderFloat(-5.5, 2.0)
    const towardPositive: f32 = truncate(3.9)
    const towardNegative: f32 = truncate(-3.9)
    return remainder + negativeRemainder + towardPositive + towardNegative
}

const testRounding = () => {
    const down: f32 = roundDown(3.7)
    const up: f32 = roundUp(3.2)
    const nearest: f32 = roundNearest(3.5)
    // Halfway away from zero.
    const nearestNegative: f32 = roundNearest(-3.5)
    return down + up + nearest + nearestNegative
}

const testRandom = () => {
    seedRandom(12345)
    const first: i32 = randomInteger(0, 100)
    const second: i32 = randomInteger(0, 100)
    return first + second
}

const testBitHelpers = () => {
    const source: u32 = 10
    const isSet: boolean = readBitValue(source, 1)
    const withHigh: u32 = setBitValue(source, 3)
    const withLow: u32 = clearBitValue(source, 1)
    const conditional: u32 = writeBitValue(source, 2, isSet)
    if (isSet) {
        return withHigh + withLow + conditional + 1
    }
    return withHigh + withLow + conditional
}

const testByteAndMaskHelpers = () => {
    const source: u32 = 43981
    const low: u8 = lowByteValue(source)
    const high: u8 = highByteValue(source)
    const firstBit: u32 = bitMask(0)
    const eighthBit: u32 = bitMask(7)
    const highestBit: u32 = bitMask(31)
    const outOfRange: u32 = bitMask(32)
    return low + high + firstBit + eighthBit + highestBit + outOfRange
}

const testTrigonometry = () => {
    const sinZero: f32 = sine(0.0)
    const cosZero: f32 = cosine(0.0)
    const tanZero: f32 = tangent(0.0)
    const radians: f32 = toRadians(180.0)
    const degrees: f32 = toDegrees(radians)
    return sinZero + cosZero + tanZero + radians + degrees
}

const testInverseTrigonometry = () => {
    const fromSine: f32 = arcSine(0.5)
    const fromCosine: f32 = arcCosine(0.5)
    const fromTangent: f32 = arcTangent(1.0)
    const quadrant: f32 = arcTangent2(1.0, -1.0)
    const domainEdge: f32 = arcSine(1.0)
    return fromSine + fromCosine + fromTangent + quadrant + domainEdge
}

const testFloat64Helpers = () => {
    // More than seven significant digits: f64 keeps them, f32 would not.
    const precise: f64 = 3.14159265358979
    const singlePrecision: f32 = squareRoot(16.0)
    const doublePrecision: f64 = squareRoot(precise)
    const squared: f64 = square(precise)
    const clamped: f64 = clampFloat(precise, 0.0, 3.0)
    const remapped: f64 = interpolateRangeFloat(precise, 0.0, 3.14159265358979, 0.0, 100.0)
    const rounded: f64 = roundNearest(precise)
    const truncated: f64 = truncate(precise)
    const remainder: f64 = remainderFloat(precise, 0.5)
    const magnitude: f64 = absoluteFloat(-precise)
    const smallest: f64 = minimumFloat(precise, 3.0)
    const radians: f64 = toRadians(precise)
    const sineValue: f64 = sine(precise)
    const wideNatural: f64 = naturalLog(precise)
    // Mixed f32/f64 arguments select f64 and cast the f32 argument explicitly.
    const mixedMinimum: f64 = minimumFloat(singlePrecision, precise)
    const mixedPower: f64 = power(singlePrecision, precise)
    const mixedRemapped: f64 = interpolateRangeFloat(singlePrecision, 0.0, 1.0, 0.0, precise)
    return singlePrecision + doublePrecision + squared + clamped + remapped + rounded + truncated + remainder + magnitude + smallest + radians + sineValue + wideNatural + mixedMinimum + mixedPower + mixedRemapped
}

// The result type follows the selected overload, so an unannotated const keeps
// f64 instead of a fixed f32.
const testFloat64Inference = (value: f64) => {
    const inferredSquare = square(value)
    const inferredRoot = squareRoot(value)
    return inferredSquare + inferredRoot
}

// Declared f32 destination: the f64 overload is selected, and the f64 result
// is cast explicitly with a non-blocking narrowing warning instead of an error.
const testMixedWidthNarrowing = (value: f64) => {
    const remapped: f32 = interpolateRangeFloat(value, 0.0, 1.0, 0.0, 100.0)
    return remapped
}

// A u32 * i16 product does not fit f32 exactly, so square picks f64.
const testWidenedIntegerProduct = (count: u32, factor: i16) => {
    const product = count * factor
    const squared: f64 = square(product)
    return squared
}

// u64 into an i32 parameter: explicit cast plus a non-blocking warning.
const testWidenedIntegerNarrowing = (wide: u64) => {
    const bounded: i32 = clamp(wide, 0, 100)
    return bounded
}

// A u32 above the i32 range must keep its magnitude: the i64 overloads run the
// whole operation at 64 bits instead of wrapping the argument negative.
const testLargeUnsignedIntegerMath = (value: u32) => {
    const clamped: i64 = clamp(value, 0, 10)
    const wideClamped: i64 = clamp(value, 0, 4000000000)
    const smallest: i64 = minimum(value, 2000000000)
    const largest: i64 = maximum(value, 2000000000)
    const magnitude: i64 = absolute(value)
    const remapped: i64 = interpolateRange(value, 0, 4000000000, 0, 1000)
    // All-unsigned operands keep the u32 overload; integer literals are i32.
    const zero: u32 = 0
    const upper: u32 = 4000000000
    const allUnsigned: u32 = clamp(value, zero, upper)
    const allUnsignedSmallest: u32 = minimum(value, upper)
    // Small i32 operands still take the cheap word-sized overload.
    const small: i32 = clamp(5, 0, 10)
    return clamped + wideClamped + smallest + largest + magnitude + remapped + allUnsigned + allUnsignedSmallest + small
}

// The wide value decides the overload even when every other argument is i32:
// the u32 range loss dominates the number of cheap i32 arguments.
const testLargeUnsignedWithSignedBounds = (wide: u32, low: i32, high: i32) => {
    const clamped: i64 = clamp(wide, low, high)
    const remapped: i64 = interpolateRange(wide, low, high, 0, 1000)
    return clamped + remapped
}

const testMixedUnsignedIntegerMath = (small: u8, wide: u32) => {
    // All-unsigned arguments keep u32 regardless of their order.
    const lowFirst: u32 = clamp(small, wide, wide)
    const lowLast: u32 = clamp(wide, wide, small)
    const smallest: u32 = minimum(small, wide)
    return lowFirst + lowLast + smallest
}

const setup = () => {}

const main = () => {
    setup()
    testInterpolateRangeIntegers()
    testInterpolateRangeFloat()
    testClampIntegers()
    testClampFloat()
    testIntegerMath()
    testFloatMath()
    testLogarithms()
    testRounding()
    testRemainderAndTruncate()
    testRandom()
    testBitHelpers()
    testByteAndMaskHelpers()
    testTrigonometry()
    testInverseTrigonometry()
    testFloat64Helpers()
    testFloat64Inference(3.14159265358979)
    testMixedWidthNarrowing(3.14159265358979)
    testWidenedIntegerProduct(2, 3)
    testWidenedIntegerNarrowing(7)
    testLargeUnsignedIntegerMath(3000000000)
    testLargeUnsignedWithSignedBounds(3000000000, -5, 10)
    testMixedUnsignedIntegerMath(5, 3000000000)
}

main()
