import { getSerial, Serial } from '@embedito95/serial'

const serial = getSerial(Serial.1)

type Point = {
    x: i16
    y: i16
}

// Write-through: mutating a field of a param reaches the caller's object
// (shared handle, not a deep copy).
const shift = (p: Point, dx: i16) => {
    p.x = p.x + dx
}

// Reassigning the param rebinds only the LOCAL handle; caller is untouched.
const reset = (p: Point) => {
    p = { x: 100, y: 200 }
}

const setup = () => {
    serial.initialize(9600)
}

const main = () => {
    setup()

    const a: Point = { x: 1, y: 2 }
    let b = a
    b.x = 9
    serial.sendLine(a.x)
    serial.sendLine(a.y)

    shift(a, 5)
    serial.sendLine(a.x)
    serial.sendLine(b.x)

    reset(a)
    serial.sendLine(a.x)
    serial.sendLine(a.y)

    const c: Point = { x: 1, y: 2 }
    c.x = 7
    serial.sendLine(a.x)
    serial.sendLine(c.x)
}

main()
