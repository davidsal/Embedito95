// Reads the digital state of a button and turns the onboard LED on while it is pressed.
// Example created by David Melara.

import { setDigital, setMode, getDigital, Pin, INPUT_PULLUP, OUTPUT, HIGH, LOW, LED_BUILTIN } from '@embedito95/gpio'
import { delay } from '@embedito95/time'

const button = () => {
    while (true) {
        const buttonState = getDigital(Pin.2)

        if (buttonState == LOW) {
            setDigital(LED_BUILTIN, HIGH)
        } else {
            setDigital(LED_BUILTIN, LOW)
        }

        delay(50)
    }
}

const setup = () => {
    setMode(Pin.2, INPUT_PULLUP)
    setMode(LED_BUILTIN, OUTPUT)
}

const main = () => {
    setup()
    button()
}

main()
