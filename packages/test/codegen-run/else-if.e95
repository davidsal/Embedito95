import { Pin, setAnalog } from '@embedito95/gpio'

// `else if` is a nested if-statement, not a block. The codegen used to render
// every alternate as a block, so only the first branch survived and the rest
// became an empty `else {}`.
const classify = (value: u8): u8 => {
    let result: u8 = 0
    if (value < 2) {
        result = 1
    } else if (value < 4) {
        result = 2
    } else if (value < 6) {
        result = 3
    } else {
        result = 4
    }
    return result
}

const setup = () => {}

const main = () => {
    setup()
    setAnalog(Pin.3, classify(0))
    setAnalog(Pin.4, classify(3))
    setAnalog(Pin.5, classify(5))
    setAnalog(Pin.6, classify(7))
}

main()
