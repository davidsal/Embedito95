import { Pin, setMode, PinMode, setAnalog, setDigital, HIGH, LOW } from '@embedito95/gpio'
import { sleep } from '@embedito95/async'

const readSensor = async (): u8 => {
    return 42
}

const blink = async () => {
    const value = await readSensor()
    setAnalog(Pin.3, value)
    setDigital(Pin.10, HIGH)
    await sleep(50)
    setDigital(Pin.10, LOW)
}

const setup = () => {
    setMode(Pin.10, PinMode.OUTPUT)
}

const main = () => {
    setup()
    blink()
}

main()
