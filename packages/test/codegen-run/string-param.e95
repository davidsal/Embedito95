import { Pin, setAnalog } from '@embedito95/gpio'

// Bug B: reassigning a `string` parameter to another string must be allowed
// (the local handle rebinds; CoW), and the new value is used afterwards.
const reassign = (s: string): u16 => {
    s = "other"
    return s.length()
}

const setup = () => {
    setAnalog(Pin.3, reassign("hi"))
}

const main = () => {
    setup()
}

main()
