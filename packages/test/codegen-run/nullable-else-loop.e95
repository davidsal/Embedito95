import { Pin, setDigital, HIGH, LOW } from '@embedito95/gpio'

// The `else` reassigns the nullable local inside a loop. The narrowed region
// must end there: the codegen has to return the option (null) instead of
// reading the option payload (7) on every loop shape that can assign.
const computeWhile = (): u8 | null => {
    let value: u8 | null = 7 as u8
    if (value == null) {
        return null
    } else {
        let flag: boolean = true
        while (flag) {
            value = null
            break
        }
    }
    return value
}

const computeFor = (): u8 | null => {
    let value: u8 | null = 7 as u8
    if (value == null) {
        return null
    } else {
        for (let index: u8 = 0; index < 1; index += 1) {
            value = null
        }
    }
    return value
}

const computeDo = (): u8 | null => {
    let value: u8 | null = 7 as u8
    if (value == null) {
        return null
    } else {
        let flag: boolean = false
        do {
            value = null
        } while (flag)
    }
    return value
}

const computeWithoutAssignment = (): u8 | null => {
    let value: u8 | null = 7 as u8
    if (value == null) {
        return null
    } else {
        let flag: boolean = true
        while (flag) {
            flag = false
        }
    }
    return value
}

const setup = () => {}

const main = () => {
    setup()
    const whileValue = computeWhile()
    if (whileValue == null) {
        setDigital(Pin.10, HIGH)
    } else {
        setDigital(Pin.10, LOW)
    }
    const forValue = computeFor()
    if (forValue == null) {
        setDigital(Pin.11, HIGH)
    } else {
        setDigital(Pin.11, LOW)
    }
    const doValue = computeDo()
    if (doValue == null) {
        setDigital(Pin.12, HIGH)
    } else {
        setDigital(Pin.12, LOW)
    }
    const keptValue = computeWithoutAssignment()
    if (keptValue == null) {
        setDigital(Pin.13, HIGH)
    } else {
        setDigital(Pin.13, LOW)
    }
}

main()
