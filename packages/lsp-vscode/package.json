{
	"name": "embedito95-lsp",
	"displayName": "Embedito95 Language Support",
	"description": "Language support for .e95 files",
	"version": "1.0.0",
	"publisher": "embedito95",
	"private": true,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davidsal/Embedito95.git",
		"directory": "packages/lsp-vscode"
	},
	"homepage": "https://github.com/davidsal/Embedito95#readme",
	"bugs": {
		"url": "https://github.com/davidsal/Embedito95/issues"
	},
	"icon": "./src/icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"languages": [
			{
				"id": "e95",
				"extensions": [
					".e95"
				],
				"configuration": "./src/language-configuration.json",
				"icon": {
					"light": "./src/icons/e95_logo.png",
					"dark": "./src/icons/e95_logo.png"
				}
			}
		],
		"grammars": [
			{
				"language": "e95",
				"scopeName": "source.e95",
				"path": "./src/grammars/e95.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"[e95]": {
				"editor.formatOnSave": true,
				"editor.tabSize": 4,
				"editor.insertSpaces": true,
				"editor.semanticTokenColorCustomizations": {
					"enabled": true,
					"rules": {
						"enumMember": "#4fc1ff"
					}
				}
			}
		}
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"package": "node build.mjs && npx vsce package --no-dependencies"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.25.0"
	}
}
